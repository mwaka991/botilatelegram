[Unit]
Description=Telegram Channel Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telegrambot
Group=telegrambot
WorkingDirectory=/opt/telegram-channel-bot
EnvironmentFile=/etc/telegram-channel-bot.env
ExecStart=/opt/telegram-channel-bot/.venv/bin/python /opt/telegram-channel-bot/bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
